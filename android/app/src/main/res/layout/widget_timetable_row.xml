<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="23dp" android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView android:id="@+id/widget_day" android:layout_width="48dp" android:layout_height="wrap_content"
        android:textSize="12sp" android:textStyle="bold" android:textColor="#14324B" />
    <TextView android:id="@+id/widget_entries" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="12sp" android:textColor="#465D72" />
</LinearLayout>
