<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textStyle="bold" android:textSize="16sp" android:textColor="#14324B" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="42dp" android:layout_height="36dp"
            android:gravity="center" android:text="↻" android:textColor="#0964A5" android:textSize="20sp"
            android:contentDescription="@string/widget_refresh" />
        <TextView android:id="@+id/widget_settings" android:layout_width="42dp" android:layout_height="36dp"
            android:gravity="center" android:text="⚙" android:textColor="#0964A5" android:textSize="18sp"
            android:contentDescription="@string/widget_settings" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp" android:textSize="11sp" android:textColor="#536677" />
</LinearLayout>
