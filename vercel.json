{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:deploy",
  "git": {
    "deploymentEnabled": true
  },
  "github": {
    "autoJobCancelation": true
  },
  "outputDirectory": "dist",
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/service",
      "destination": "/service.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/notices",
      "destination": "/notices.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/notices/picture-messages",
      "destination": "/notices/picture-messages.html"
    },
    {
      "source": "/notices/schedule-registration",
      "destination": "/notices/schedule-registration.html"
    },
    {
      "source": "/notices/welcome-guide",
      "destination": "/notices/welcome-guide.html"
    },
    {
      "source": "/blog/shared-morning",
      "destination": "/blog/shared-morning.html"
    },
    {
      "source": "/blog/first-picture-conversation",
      "destination": "/blog/first-picture-conversation.html"
    },
    {
      "source": "/blog/monthly-tuition-routine",
      "destination": "/blog/monthly-tuition-routine.html"
    },
    {
      "source": "/((?!api(?:/|$)|assets/|robots\\.txt$|sitemap\\.xml$|\\.well-known/|sw\\.js$|manifest\\.webmanifest$|app-icon\\.svg$|icon\\.svg$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "env": {
    "DEMO_MODE": "true"
  }
}
