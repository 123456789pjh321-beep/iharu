# Copy to .env.local. Never commit credentials. No VITE_ database or auth secrets.
# APP_ENV: local | preview | production. Production always disables demo data.
APP_ENV=
# true | false. Local defaults to demo; Preview requires explicit true.
DEMO_MODE=
APP_DATABASE_URL=
AUTH_DATABASE_URL=
WORKER_DATABASE_URL=
# Administrative migration connection; never used by the web request handler.
MIGRATION_DATABASE_URL=
# Used by db:migrate to verify the intended target (local | preview | production).
MIGRATION_TARGET=
# P02: exact public origin without trailing slash. Local Vite: http://localhost:5173.
# Production: https://iharu.vercel.app. Each Preview needs its own origin and test credentials.
APP_ORIGIN=
# Generate at least 32 random bytes. Never use a sample/default value.
BETTER_AUTH_SECRET=
# Optional providers are disabled until their required values are set.
# Resend: verified sending domain/address. Server-only.
RESEND_API_KEY=
MAIL_FROM=
# Register APP_ORIGIN/api/auth/callback/{google|kakao|naver} with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# SOLAPI: approved domestic sender. Budget is a hard cap on send attempts per rolling 24h.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=
SMS_DAILY_BUDGET=
# P04: portal's decoded key. XML source: data.go.kr / KASI special days.
HOLIDAY_API_KEY=
# Vercel Cron authorization, at least 32 random characters. Server-only.
CRON_SECRET=
# WORKER_DATABASE_URL above must use a separate non-owner login with worker_runtime only.
# F07: production uses one GET /api/cron/tick per minute. Redeploy after changing secrets.
# CRON_SECRET: 32-256 printable ASCII characters without spaces/newlines.
# setup:check reports maintenance readiness without printing values; it is not a connectivity test.

# P07-F08: runtime-only private Realtime. Omit all three to keep 15-second polling.
REALTIME_SUPABASE_URL=
REALTIME_PUBLISHABLE_KEY=
# Imported ES256 JWK (including kid/d), approved by Supabase; Production Secret only. Never VITE_.
REALTIME_SIGNING_JWK=

# UI137: server-only 32-byte random key encoded as 64 hex characters.
# Store as a Production Secret, separately from the database. Never VITE_.
# Do not rotate while encrypted credentials remain without a migration/re-registration plan.
AI_CREDENTIAL_ENCRYPTION_KEY=

